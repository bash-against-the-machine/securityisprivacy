:root {
    --bg-primary: #0d1117;
    --bg-secondary: #161b22;
    --bg-card: #1c2128;
    --border-color: #30363d;
    --text-primary: #e6edf3;
    --text-muted: #8b949e;
    --accent: #00ff41;
    --accent-dim: #00cc33;
    --accent-glow: rgba(0, 255, 65, 0.15);
    --danger: #ff4444;
    --warning: #ffa500;
}

body {
    background-color: var(--bg-primary);
    color: var(--text-primary);
    font-family: 'Courier New', Courier, monospace;
}

/* Navbar */
.navbar {
    background-color: var(--bg-secondary) !important;
    border-bottom: 1px solid var(--border-color);
}

.navbar-brand {
    color: var(--accent) !important;
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: 1px;
}

.navbar-brand span {
    color: var(--text-primary);
}

.nav-link {
    color: var(--text-muted) !important;
    letter-spacing: 0.5px;
    transition: color 0.2s;
}

.nav-link:hover,
.nav-link.active {
    color: var(--accent) !important;
}

/* Hero */
.hero {
    background: linear-gradient(135deg, var(--bg-secondary) 0%, var(--bg-primary) 100%);
    border-bottom: 1px solid var(--border-color);
    padding: 5rem 0 4rem;
    position: relative;
    overflow: hidden;
}

.hero::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0, 255, 65, 0.02) 2px,
        rgba(0, 255, 65, 0.02) 4px
    );
    pointer-events: none;
}

.hero-title {
    color: var(--accent);
    font-size: 3rem;
    font-weight: 700;
    text-shadow: 0 0 20px var(--accent-glow);
    letter-spacing: 2px;
}

.hero-tagline {
    color: var(--text-muted);
    font-size: 1.1rem;
    letter-spacing: 1px;
}

.hero-tagline .prompt {
    color: var(--accent);
}

/* Cards */
.card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    transition: border-color 0.2s, box-shadow 0.2s;
}

.card:hover {
    border-color: var(--accent);
    box-shadow: 0 0 12px var(--accent-glow);
}

.card-title a {
    color: var(--text-primary);
    text-decoration: none;
}

.card-title a:hover {
    color: var(--accent);
}

.card-text {
    color: var(--text-muted);
    font-size: 0.9rem;
}

/* Section headers */
.section-header {
    color: var(--accent);
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 1.1rem;
    letter-spacing: 1px;
    text-transform: uppercase;
}

.section-header::before {
    content: "// ";
    opacity: 0.5;
}

/* Badges */
.badge-category {
    background-color: var(--accent-glow);
    color: var(--accent);
    border: 1px solid var(--accent-dim);
    font-size: 0.7rem;
    letter-spacing: 0.5px;
}

.badge-easy { background-color: rgba(0, 255, 65, 0.1); color: var(--accent); border: 1px solid var(--accent-dim); }
.badge-medium { background-color: rgba(255, 165, 0, 0.1); color: var(--warning); border: 1px solid var(--warning); }
.badge-hard { background-color: rgba(255, 68, 68, 0.1); color: var(--danger); border: 1px solid var(--danger); }
.badge-cost { background-color: rgba(100, 160, 255, 0.1); color: #64a0ff; border: 1px solid #64a0ff; font-size: 0.7rem; letter-spacing: 0.5px; }

/* Post/guide detail */
.detail-meta {
    color: var(--text-muted);
    font-size: 0.85rem;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 1rem;
    margin-bottom: 2rem;
}

.detail-body {
    color: var(--text-primary);
    line-height: 1.8;
}

.detail-body h2, .detail-body h3 {
    color: var(--accent);
    margin-top: 2rem;
}

.detail-body code {
    background-color: var(--bg-secondary);
    color: var(--accent);
    padding: 0.1em 0.4em;
    border-radius: 3px;
    font-size: 0.9em;
}

.detail-body pre {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 1rem;
    overflow-x: auto;
}

.detail-body pre code {
    background: none;
    padding: 0;
}

/* Buttons */
.btn-accent {
    background-color: transparent;
    color: var(--accent);
    border: 1px solid var(--accent);
    font-size: 0.8rem;
    letter-spacing: 0.5px;
    transition: all 0.2s;
}

.btn-accent:hover {
    background-color: var(--accent-glow);
    color: var(--accent);
    box-shadow: 0 0 8px var(--accent-glow);
}

/* About page */
.about-section {
    max-width: 800px;
}

/* Footer */
footer {
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-color);
    color: var(--text-muted);
    font-size: 0.85rem;
}

footer .accent { color: var(--accent); }

/* Page title bar */
.page-header {
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
    padding: 2rem 0 1.5rem;
    margin-bottom: 2.5rem;
}

.page-header h1 {
    color: var(--accent);
    font-size: 1.6rem;
    letter-spacing: 1px;
}

/* Source link */
.source-link {
    color: var(--accent-dim);
    font-size: 0.8rem;
    text-decoration: none;
}

.source-link:hover {
    color: var(--accent);
    text-decoration: underline;
}

/* Back link */
.back-link {
    color: var(--text-muted);
    font-size: 0.85rem;
    text-decoration: none;
}

.back-link:hover {
    color: var(--accent);
}

.back-link::before {
    content: "← ";
}

/* Guide prev/next navigation */
.guide-nav {
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--border-color);
    padding-top: 1.5rem;
    gap: 1rem;
}

.guide-nav-prev,
.guide-nav-next {
    color: var(--accent-dim);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
}

.guide-nav-prev:hover,
.guide-nav-next:hover {
    color: var(--accent);
}

.guide-nav-next {
    margin-left: auto;
}
